programa
{
	
	funcao inicio()
	{
		inteiro valor1, valor2

		escreva ("Digite um valor:\n")
		leia (valor1)
		se (valor1 >0){
		escreva (valor1 + 5)	
		}
		 senao se (valor1 <0){
		  escreva (valor1 -10)	
		  }
		   senao se  (valor1 ==0){
		    escreva ("Digite um valor:\n")
		    leia(valor2)
		    escreva (valor2 *3)
		    }
	}
}
