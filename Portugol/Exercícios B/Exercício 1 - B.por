programa
{
	
	funcao inicio()
	{
		inteiro valorA, valorB

		escreva("Digite dois valores:\n")
		leia(valorA, valorB)
		
			se (valorA > valorB){
			escreva(valorA, " maior que ", valorB)	
		     }
		     	senao se (valorA < valorB){
				escreva(valorA, " menor que ", valorB)
		     	}
					senao se (valorA == valorB){
					escreva(valorA," igual a ", valorB)	
					}
	}
}

