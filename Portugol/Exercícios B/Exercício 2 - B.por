programa
{
	
	funcao inicio()
	{
		inteiro valor1

		escreva("Digite um número:\n")
		leia(valor1)
		se(valor1 % 2 == 0){
		 escreva("Par")	
		}senao{
		  escreva("Impar")
		}
	}
}
