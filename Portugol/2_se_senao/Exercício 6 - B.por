programa
{
	
	funcao inicio()
	{
		inteiro valor1, valor2, valor3

		escreva ("Digite 3 numero inteiros:\n")
		leia (valor1, valor2, valor3)

		se (valor1 > valor2 e valor1 > valor3){
		escreva(valor1)	
		}
		 se (valor2 > valor1 e valor2 > valor3){
		 escreva (valor2)
		 }
		  se (valor3 > valor1 e valor3 > valor2){
		  escreva(valor3)	
		  } 
	}
}
