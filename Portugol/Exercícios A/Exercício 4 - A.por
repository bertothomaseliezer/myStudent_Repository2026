programa
{
	
	funcao inicio()
	{
	inteiro  anos, meses, dias, totalDias
	escreva("Diga a sua Idade em Anos, Meses e Dias:\n")
	leia(anos, meses, dias)
	totalDias = (anos * 365) + (meses * 30) + (dias)
	escreva("total de dias é: ", totalDias) 
	}
}
