programa
{
	
	funcao inicio()
	{
		real base, altura, area
		escreva("digite um valor para b (base) e h (altura):\n")
		leia(base, altura)
		area=(base * altura)/2
		escreva("A área do triângulo é: ", area)	
	}
}
