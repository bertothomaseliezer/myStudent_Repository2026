programa
{
	
	funcao inicio()
	{
		inteiro valorA, valorB, valorC, calculoR, calculoS, calculoD 	
		escreva("Digite 3 valores inteiros e positivos:\n")
		leia(valorA, valorB, valorC)		
		calculoR=(valorA + valorB)
		calculoS=(valorB + valorC)
		calculoD=(calculoR + calculoS)/2
		escreva("O valor da letra D é: ", calculoD)
		}	
}
