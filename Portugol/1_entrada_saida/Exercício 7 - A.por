programa
{
	
	funcao inicio()
	{
		real custoFabrica, custoTotal

		escreva("Digite custo de fábrica do automóvel:\n")
		leia(custoFabrica)
		custoTotal = custoFabrica + (custoFabrica * 0.28) + (custoFabrica * 0.45)
		escreva("O custo total com as taxas sera de\n",custoTotal)
		
		
	}
}
